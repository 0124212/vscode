{
    // ── Typography ── beautiful, airy, JetBrains Mono
    "editor.fontFamily": "JetBrains Mono, CaskaydiaMono Nerd Font, Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 22,
    "editor.letterSpacing": 0.3,
    "editor.fontWeight": "400",
    "terminal.integrated.fontFamily": "JetBrains Mono, CaskaydiaMono Nerd Font, Consolas, monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.lineHeight": 1.2,

    // ── Theme ── Vitesse Dark — minimal warm ink
    "workbench.colorTheme": "Vitesse Dark",
    "workbench.iconTheme": "vs-minimal",

    // ── Layout ── top bar, no clutter, center focus
    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "top",
    "workbench.layoutControl.enabled": false,
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "never",
    "workbench.list.openMode": "singleClick",
    "workbench.list.smoothScrolling": true,
    "workbench.tree.expandMode": "singleClick",
    "window.commandCenter": false,
    "window.titleBarStyle": "custom",
    "breadcrumbs.enabled": false,
    "workbench.statusBar.visible": true,
    "workbench.sideBar.location": "left",
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.wrapTabs": true,
    "workbench.editor.pinnedTabsOnSeparateRow": false,
    "workbench.editor.highlightModifiedTabs": true,

    // ── Editor chrome ── quiet, minimal highlights
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.scrollbar.verticalScrollbarSize": 6,
    "editor.scrollbar.horizontalScrollbarSize": 6,
    "editor.renderLineHighlight": "gutter",
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [],
    "editor.glyphMargin": false,
    "editor.folding": true,
    "editor.showFoldingControls": "never",
    "editor.stickyScroll.enabled": false,
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": false,
    "editor.matchBrackets": "near",
    "editor.guides.bracketPairs": "active",
    "editor.guides.indentation": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.lightbulb.enabled": "off",
    "editor.hover.delay": 400,
    "editor.quickSuggestionsDelay": 30,
    "editor.suggest.preview": true,
    "editor.linkedEditing": true,
    "editor.wordWrap": "off",
    "editor.wrappingIndent": "indent",

    // ── Cursor & motion ── smooth, calm
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",

    // ── Explorer ── compact + nesting
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "*.vue": "${capture}.vue.*",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb"
    },
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.openEditors.visible": 0,
    "explorer.decorations.colors": true,
    "explorer.decorations.badges": true,

    // ── Files ── auto-save, clean ends
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 800,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.simpleDialog.enable": true,

    // ── Formatting
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    // ── Git ── quiet
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.decorations.enabled": true,
    "scm.diffDecorations": "gutter",
    "scm.diffDecorationsGutterWidth": 2,

    // ── Noise off
    "workbench.tips.enabled": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "problems.decorations.enabled": true,

    // ── Power user ── minimal cost, high signal
    "files.hotExit": "onExitAndWindowClose",
    "files.watcherExclude": {
        "**/target/**": true,
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/.hg/store/**": true,
        "**/dist/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/dist": true,
        "**/.git": true,
        "**/.hg": true,
        "**/*.code-search": true
    },
    "search.followSymlinks": false,
    "search.searchOnType": true,
    "search.searchOnTypeDebouncePeriod": 300,
    "editor.largeFileOptimizations": true,
    "editor.wordBasedSuggestions": "off",
    "editor.suggestSelection": "first",
    "workbench.editor.limit.enabled": false,
    "explorer.openEditors.sortOrder": "alphabetical",

    // GitLens minimal
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.enabled": false,

    // Error Lens quiet
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.delay": 300,
    "errorLens.excludeBySource": ["eslint"],

    // Spell / Todo (if extensions installed, no UI until used)
    "cSpell.enabled": true,
    "cSpell.allowCompoundWords": true,
    "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "NOTE"],
    "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true
}
